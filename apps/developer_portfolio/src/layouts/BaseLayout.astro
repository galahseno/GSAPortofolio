---
import { ClientRouter } from "astro:transitions";
import Navigation from "../components/Navigation/Navigation";
import Footer from "../components/Footer/Footer.astro";
import StructuredData from "../components/seo/StructuredData.astro";
import { BASE_URL } from "../constants/paths";
import {
  DEFAULT_LANG,
  LANGS,
  OG_LOCALE,
  localeHref,
  type Lang,
} from "../i18n/config";
import { UI } from "../i18n/ui";
import "../styles/tokens.css";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
}

const { lang, ogImage = `${BASE_URL}og-image.png` } = Astro.props;
const ui = UI[lang];
const title = Astro.props.title ?? ui.siteTitle;
const description = Astro.props.description ?? ui.siteDescription;

const absolute = (target: Lang) => new URL(localeHref(target), Astro.site).href;
const canonical = absolute(lang);
const ogImageUrl = new URL(ogImage, Astro.site).href;
const otherLocales = LANGS.filter((code) => code !== lang);
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="theme-color" content="#fbfaf9" />
    <script is:inline>
      (function () {
        var THEME_COLORS = { light: "#fbfaf9", dark: "#100e0d" };

        function syncThemeColor() {
          var meta = document.querySelector('meta[name="theme-color"]');
          var theme = document.documentElement.getAttribute("data-theme");
          if (meta)
            meta.setAttribute(
              "content",
              THEME_COLORS[theme] || THEME_COLORS.light,
            );
        }

        try {
          var stored = localStorage.getItem("gsa-theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }

        syncThemeColor();
        new MutationObserver(syncThemeColor).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
        document.addEventListener("astro:after-swap", syncThemeColor);
      })();

      document.addEventListener("astro:before-swap", function (event) {
        var theme = document.documentElement.getAttribute("data-theme");
        if (theme)
          event.newDocument.documentElement.setAttribute("data-theme", theme);
      });
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      LANGS.map((code) => (
        <link rel="alternate" hreflang={code} href={absolute(code)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={absolute(DEFAULT_LANG)} />

    <link rel="icon" href={`${BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link
      rel="icon"
      href={`${BASE_URL}favicon-96.png`}
      type="image/png"
      sizes="96x96"
    />
    <link rel="apple-touch-icon" href={`${BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE_URL}site.webmanifest`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Galah Seno Adjie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {
      otherLocales.map((code) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[code]} />
      ))
    }
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      googleVerification && (
        <meta name="google-site-verification" content={googleVerification} />
      )
    }

    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href={`${BASE_URL}fonts/Exo2-Variable.ttf`}
      crossorigin="anonymous"
    />
    <StructuredData lang={lang} canonical={canonical} />
    <ClientRouter />
  </head>
  <body>
    <Navigation client:load lang={lang} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
