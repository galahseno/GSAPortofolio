---
import SectionHeading from "../shared/SectionHeading.astro";
import ContactForm from "./ContactForm";
import { SPRITE_URL } from "../../constants/paths";
import { CONTACT_CONTENT } from "./contactContent";

const { ghost, eyebrow, title, intro, email, location, availability } = CONTACT_CONTENT;

const infoRowStyle =
  "display: flex; align-items: center; gap: var(--space-4); padding: var(--space-5) 0; border-top: 1px solid var(--border-subtle)";
const infoRowLastStyle = `${infoRowStyle}; border-bottom: 1px solid var(--border-subtle)`;
const infoIconStyle =
  "flex: none; width: 16px; height: 16px; color: var(--accent);";
---

<section
  id="contact"
  data-screen-label="Contact"
  class="section-stack"
>
  <div>
      <SectionHeading ghost={ghost} eyebrow={eyebrow} title={title} />
    </div>

    <div
      style="display: flex; flex-wrap: wrap; gap: var(--space-12); align-items: flex-start"
    >
      <div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: var(--space-8)">
        <p
          style="margin: 0; max-width: 46ch; font-size: var(--text-lead); line-height: 1.7; color: var(--text-muted)"
        >
          {intro}
        </p>

        <div style="display: flex; flex-direction: column">
          <div style={infoRowStyle}>
            <svg aria-hidden="true" style={infoIconStyle}>
              <use href={`${SPRITE_URL}#mail-icon`} />
            </svg>
            <a
              href={`mailto:${email}`}
              style="min-width: 0; flex: 1; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--text-heading); overflow-wrap: anywhere"
            >
              {email}
            </a>
          </div>

          <div style={infoRowStyle}>
            <svg aria-hidden="true" style={infoIconStyle}>
              <use href={`${SPRITE_URL}#map-pin-icon`} />
            </svg>
            <span style="font-size: var(--text-sm); color: var(--text-body)">{location}</span>
          </div>

          <div style={infoRowLastStyle}>
            <svg aria-hidden="true" style={infoIconStyle}>
              <use href={`${SPRITE_URL}#calendar-icon`} />
            </svg>
            <span style="font-size: var(--text-sm); color: var(--text-body)">{availability}</span>
          </div>
        </div>
      </div>

      <div style="flex: 1.4 1 420px; min-width: 0">
        <ContactForm client:visible />
      </div>
    </div>
</section>
