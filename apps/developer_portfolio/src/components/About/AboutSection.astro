---
import { Image } from "astro:assets";
import { SPRITE_URL } from "../../constants/paths";
import SectionHeading from "../shared/SectionHeading.astro";
import { ABOUT_CONTENT } from "./aboutContent";
import portrait from "../../assets/portrait.jpg";

const { paragraphs, portraitAlt, location, pipeline, stats } = ABOUT_CONTENT;
---

<section
  id="about"
  data-screen-label="About"
  class="section-stack"
>
    <div>
      <SectionHeading
        ghost={ABOUT_CONTENT.ghost}
        eyebrow={ABOUT_CONTENT.eyebrow}
        eyebrowGhostAlign={true}
        eyebrowSize="40px"
      />
    </div>

    <div
      style="margin-top: var(--space-6); display: flex; flex-direction: row-reverse; flex-wrap: wrap; gap: var(--space-12); align-items: center; justify-content: flex-end"
    >
      <div
        style="flex: 0 1 360px; min-width: 260px; display: flex; flex-direction: column; align-items: center; gap: var(--space-4)"
      >
        <div style="position: relative; width: 100%">
          <div
            aria-hidden="true"
            style="position: absolute; left: -34%; right: -34%; top: -30%; bottom: -18%; background: radial-gradient(closest-side ellipse at 50% 46%, var(--accent-glow) 0%, transparent 78%); pointer-events: none"
          >
          </div>
          <div
            aria-hidden="true"
            style="position: absolute; inset: 16px -16px -16px 16px; border-radius: var(--radius-lg); background: var(--surface-inset); border: 1px solid var(--border-subtle)"
          >
          </div>
          <div
            style="position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-subtle); background: var(--surface-inset)"
          >
            <Image
              src={portrait}
              alt={portraitAlt}
              widths={[360, 720]}
              sizes="(max-width: 640px) calc(100vw - 64px), 360px"
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover; object-position: center 20%; display: block"
            />
          </div>
        </div>
        <div
          style="margin-top: var(--space-2); display: flex; align-items: center; gap: var(--space-2); color: var(--text-muted)"
        >
          <svg
            aria-hidden="true"
            width="24"
            height="24"
            style="flex: none; color: var(--accent)"
          >
            <use href={`${SPRITE_URL}#map-pin-icon`}></use>
          </svg>
          <span
            style="font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--text-heading)"
            >{location}</span
          >
        </div>
      </div>

      <div
        style="flex: 1 1 400px; max-width: var(--content-max); display: flex; flex-direction: column; gap: var(--space-5)"
      >
        {
          paragraphs.map((paragraph) => (
            <p style="margin: 0; font-size: var(--text-lead); line-height: 1.7; color: var(--text-heading)">
              {paragraph.map((segment) =>
                segment.href ? (
                  <a
                    href={segment.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="font-weight: var(--weight-semibold); color: var(--accent); text-decoration: underline; text-decoration-color: color-mix(in oklch, var(--accent) 40%, transparent); text-underline-offset: 3px; transition: var(--transition-control)"
                  >
                    {segment.text}
                  </a>
                ) : segment.strong ? (
                  <strong style="font-weight: var(--weight-semibold); color: var(--accent)">
                    {segment.text}
                  </strong>
                ) : (
                  segment.text
                ),
              )}
            </p>
          ))
        }
      </div>
    </div>

    <div>
      <div
        aria-hidden="true"
        style="height: 1px; background: var(--grad-hairline)"
      >
      </div>
      <div class="about-marquee">
        <div class="about-marquee__mask about-marquee__mask--left"></div>
        <div class="about-marquee__track">
          <ul class="about-marquee__list">
            {
              pipeline.map((step) => (
                <li class="about-marquee__item">
                  <span>{step}</span>
                  <span class="about-marquee__delim" aria-hidden="true">
                    ∞
                  </span>
                </li>
              ))
            }
          </ul>
          <ul class="about-marquee__list" aria-hidden="true">
            {
              pipeline.map((step) => (
                <li class="about-marquee__item">
                  <span>{step}</span>
                  <span class="about-marquee__delim" aria-hidden="true">
                    ∞
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="about-marquee__mask about-marquee__mask--right"></div>
      </div>
      <div
        aria-hidden="true"
        style="height: 1px; background: var(--grad-hairline)"
      >
      </div>
    </div>

    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-8)"
    >
      {
        stats.map((stat) => (
          <div>
            <div style="font-family: var(--font-display); font-size: var(--text-h2); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-tightest); line-height: 1.05; color: var(--accent)">
              {stat.value}
            </div>
            <div style="margin-top: var(--space-2); font-size: var(--text-xs); font-weight: var(--weight-medium); letter-spacing: var(--tracking-wide); text-transform: uppercase; color: var(--text-heading)">
              {stat.label}
            </div>
            {stat.sublabel && (
              <div style="margin-top: var(--space-1); font-family: var(--font-mono); font-size: 12px; color: color-mix(in oklch, var(--accent) 70%, transparent)">
                {stat.sublabel}
              </div>
            )}
          </div>
        ))
      }
    </div>
</section>

<style>
  .about-marquee {
    position: relative;
    overflow: hidden;
    padding: var(--space-6) 0;
  }

  .about-marquee__track {
    display: flex;
    width: max-content;
    animation: about-marquee-scroll 36s linear infinite;
  }

  .about-marquee:hover .about-marquee__track {
    animation-play-state: paused;
  }

  .about-marquee__list {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0 var(--space-8) 0 0;
  }

  .about-marquee__item {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    color: var(--text-heading);
    white-space: nowrap;
  }

  .about-marquee__delim {
    color: var(--accent);
  }

  .about-marquee__mask {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 96px;
    z-index: 1;
    pointer-events: none;
  }

  .about-marquee__mask--left {
    left: 0;
    background: linear-gradient(90deg, var(--bg-page), transparent);
  }

  .about-marquee__mask--right {
    right: 0;
    background: linear-gradient(270deg, var(--bg-page), transparent);
  }

  @keyframes about-marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-marquee__track {
      animation: none;
    }
  }
</style>
