---
import type { Lang } from "../../i18n/config";
import { UI } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer
  class="glass-bar"
  style="position: relative; width: 100%; padding: var(--space-8) var(--space-6); display: flex; justify-content: center; text-align: center"
>
  <span style="font-size: var(--text-xs); color: var(--text-muted)">
    {UI[lang].footer(year)}
  </span>
</footer>
