---
import SectionHeading from "../shared/SectionHeading.astro";
import ProjectCard from "./ProjectCard.astro";
import { PROJECTS_CONTENT } from "./projectsContent";

const { ghost, eyebrow, groups } = PROJECTS_CONTENT;
---

<section
  id="project"
  data-screen-label="Projects"
  class="section-stack"
>
  <div>
    <SectionHeading
      ghost={ghost}
      eyebrow={eyebrow}
      eyebrowGhostAlign={true}
      eyebrowSize="40px"
    />
  </div>

  <div style="display: flex; flex-direction: column; gap: var(--space-12)">
    {
      groups.map((group) => (
        <div style="display: flex; flex-direction: column; gap: var(--space-6)">
          <div style="display: flex; align-items: center; gap: var(--space-4)">
            <h3 style="font-size: 11px; font-weight: var(--weight-semibold); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-accent); white-space: nowrap">
              {group.label}
            </h3>
            <span
              aria-hidden="true"
              style="flex: 1; height: 1px; background: var(--grad-hairline)"
            />
          </div>

          <div class="project-grid">
            {group.projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Two columns at most, one below ~712px. The 1px keeps the auto-fit count
     off the exact two-column boundary, where float rounding can drop to one. */
  .project-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, max(340px, calc((100% - var(--space-8)) / 2 - 1px))), 1fr)
    );
  }
</style>
