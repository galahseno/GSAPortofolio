---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { SPRITE_URL } from "../../constants/paths";
import TagChip from "../shared/TagChip.astro";
import type { Project } from "./projectsContent";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, year, platform, org, description, tags, links, cover } = project;

const covers = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/projects/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const coverImage = cover
  ? Object.entries(covers).find(([path]) => path.endsWith(`/${cover}`))?.[1].default
  : undefined;
---

<article class="project-card">
  <div class="project-card__cover">
    {
      coverImage ? (
        <Image
          src={coverImage}
          alt={`${title} cover`}
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 760px) calc(100vw - 48px), 610px"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
          style="width: 100%; height: 100%; object-fit: cover; display: block"
        />
      ) : (
        <div
          aria-hidden="true"
          style="position: absolute; inset: var(--space-4); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--space-3); padding: var(--space-4); border: 1px dashed var(--border-default); border-radius: var(--radius-md); text-align: center"
        >
          <svg width="22" height="22" style="color: var(--text-faint)">
            <use href={`${SPRITE_URL}#image-icon`} />
          </svg>
          <span style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint)">
            {title} — cover 16:10
          </span>
        </div>
      )
    }
  </div>

  <div class="project-card__body">
    <span class="project-card__bloom" aria-hidden="true"></span>

    <div style="position: relative; flex: 1 1 auto; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6)">
      <div style="display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4)">
        <h4 style="font-size: var(--text-h4); line-height: 1.15">{title}</h4>
        <span style="font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.04em; color: var(--text-faint); white-space: nowrap">
          {year}
        </span>
      </div>

      <div style="display: flex; flex-direction: column; gap: var(--space-1)">
        <span style="font-size: 11px; font-weight: var(--weight-semibold); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--text-muted)">
          {platform}
        </span>
        {
          org && (
            <span style="font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.04em; color: var(--text-faint)">
              {org}
            </span>
          )
        }
      </div>

      <p style="color: var(--text-muted)">{description}</p>

      <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2)">
        {tags.map((tag) => <TagChip>{tag}</TagChip>)}
      </div>

      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); margin-top: auto; padding-top: var(--space-5)">
        {
          links.map((link) => (
            <a
              class="project-link"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label} for ${title}`}
            >
              <svg aria-hidden="true" width="16" height="16">
                <use href={`${SPRITE_URL}#${link.icon}-icon`} />
              </svg>
              {link.label}
              <svg class="project-link__arrow" aria-hidden="true" width="14" height="14">
                <use href={`${SPRITE_URL}#arrow-up-right-icon`} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: var(--transition-surface);
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-default);
    box-shadow: var(--shadow-md);
  }

  .project-card__cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-inset);
    border-bottom: 1px solid var(--border-subtle);
  }

  .project-card__cover :global(img) {
    transition: transform 420ms var(--ease-out);
  }

  .project-card:hover .project-card__cover :global(img) {
    transform: scale(1.03);
  }

  .project-card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  /* Sits in the body, not the whole card: the cover is opaque and would hide it. */
  .project-card__bloom {
    position: absolute;
    inset: 0;
    background: var(--grad-bloom);
    opacity: 0.6;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .project-card:hover .project-card__bloom {
    opacity: 1;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--text-accent);
    text-decoration: none;
    transition: var(--transition-control);
  }

  .project-link:hover {
    color: var(--accent-hover);
  }

  .project-link__arrow {
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .project-link:hover .project-link__arrow {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover,
    .project-card:hover .project-card__cover :global(img),
    .project-link:hover .project-link__arrow {
      transform: none;
    }
  }
</style>
