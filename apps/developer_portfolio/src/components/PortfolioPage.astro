---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "./Home/HeroSection.astro";
import AboutSection from "./About/AboutSection.astro";
import ExperienceSection from "./Experience/ExperienceSection.astro";
import ProjectsSection from "./Projects/ProjectsSection.astro";
import ContactSection from "./Contact/ContactSection.astro";
import type { Lang } from "../i18n/config";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<BaseLayout lang={lang}>
  <div style="position: relative; min-height: 100vh; background: var(--bg-page); overflow-x: hidden">
    <div
      aria-hidden="true"
      style="position: absolute; inset: 0 0 auto 0; height: 620px; background: var(--grad-page); pointer-events: none"
    >
    </div>

    <main
      style="position: relative; max-width: var(--content-wide); margin: 0 auto; padding: var(--space-24) var(--space-6)"
    >
      <HeroSection lang={lang} />

      <AboutSection lang={lang} />

      <ExperienceSection lang={lang} />

      <ProjectsSection lang={lang} />

      <ContactSection lang={lang} />
    </main>
  </div>
</BaseLayout>
