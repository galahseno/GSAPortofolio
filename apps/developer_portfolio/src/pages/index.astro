---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/Home/HeroSection.astro";
import AboutSection from "../components/About/AboutSection.astro";
import ExperienceSection from "../components/Experience/ExperienceSection.astro";
import ContactSection from "../components/Contact/ContactSection.astro";
import { NAV_ITEMS } from "../components/Navigation/navItems";

const sections = NAV_ITEMS.filter((item) => item.id === "project");
---

<BaseLayout>
  <div style="position: relative; min-height: 100vh; background: var(--bg-page); overflow-x: hidden">
    <div
      aria-hidden="true"
      style="position: absolute; inset: 0 0 auto 0; height: 620px; background: var(--grad-page); pointer-events: none"
    >
    </div>

    <main
      style="position: relative; max-width: var(--content-wide); margin: 0 auto; padding: var(--space-24) var(--space-6)"
    >
      <HeroSection />

      <AboutSection />

      <ExperienceSection />

      {
        sections.map((section) => (
          <section
            id={section.id}
            data-screen-label={section.label}
            style="position: relative; display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-16) 0"
          >
            <h2
              style="margin: 0; font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: clamp(30px, 3.6vw, 46px); line-height: 1.05; letter-spacing: -0.035em; color: var(--text-heading)"
            >
              {section.label}
            </h2>
            <p style="margin: 0; font-size: var(--text-lead); color: var(--text-muted)">
              Content coming soon.
            </p>
          </section>
        ))
      }

      <ContactSection />
    </main>
  </div>
</BaseLayout>
